{
  "Gateway": {
    "ShutdownTimeoutSeconds": 30,
    "RuleRefreshIntervalSeconds": 60,
    "RuleRefreshJitterSeconds": 5
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "InputQueue": "gateway.input.q",
    "OutputQueue": "gateway.output.q",
    "RetryQueue": "gateway.retry.q",
    "DeadLetterQueue": "gateway.dlq.q",
    "InputExchange": "pipeline.input.x",
    "InputExchangeType": "direct",
    "InputRoutingKey": "gateway.input",
    "OutputExchange": "pipeline.x",
    "OutputExchangeType": "direct",
    "OutputRoutingKey": "gateway.output",
    "RetryExchange": "pipeline.retry.x",
    "RetryExchangeType": "direct",
    "RetryRoutingKey": "gateway.retry",
    "DeadLetterExchange": "pipeline.dlx",
    "DeadLetterExchangeType": "direct",
    "DeadLetterRoutingKey": "gateway.dlq",
    "PrefetchCount": 2,
    "ConsumerConcurrency": 4,
    "PublisherChannelPoolSize": 8,
    "OutputPublishConcurrency": 8,
    "RetryDelayMilliseconds": 10000,
    "MaxRetryAttempts": 3,
    "RetryCountPath": "retry.count",
    "ReconnectDelaySeconds": 5
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "Index": "rules",
    "TimeoutSeconds": 30
  }
}
