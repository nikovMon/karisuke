{
  "Gateway": {
    "ServiceName": "imaging-pipeline-gateway",
    "ShutdownTimeoutSeconds": 30,
    "RuleRefreshIntervalSeconds": 60
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "InputQueue": "gateway.input.q",
    "OutputQueue": "gateway.output.q",
    "DeadLetterQueue": "gateway.dlq.q",
    "InputExchange": "pipeline.input.x",
    "InputExchangeType": "direct",
    "InputRoutingKey": "gateway.input",
    "OutputExchange": "pipeline.x",
    "OutputExchangeType": "direct",
    "OutputRoutingKey": "gateway.output",
    "DeadLetterExchange": "pipeline.dlx",
    "DeadLetterExchangeType": "direct",
    "DeadLetterRoutingKey": "gateway.dlq",
    "HeadersArguments": {},
    "OutputQueueHeaders": {},
    "DeadLetterQueueHeaders": {},
    "InputExchangeHeaders": {},
    "OutputExchangeHeaders": {},
    "DeadLetterExchangeHeaders": {},
    "InputBindingArguments": {},
    "OutputBindingArguments": {},
    "DeadLetterBindingArguments": {},
    "PrefetchCount": 32,
    "PublisherChannelPoolSize": 4,
    "ReconnectDelaySeconds": 5
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "Username": "",
    "Password": "",
    "Index": "rules",
    "TimeoutSeconds": 30
  },
  "Output": {
    "RoutingMetadataPropertyName": "gateway",
    "FocusedGeometryPropertyName": "focusedGeometry",
    "PreserveOriginalMessage": true
  }
}
