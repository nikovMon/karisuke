{
  "Observability": {
    "Enabled": true,
    "ServiceNamespace": "findair",
    "DeploymentEnvironment": "development",
    "Traces": {
      "Enabled": true,
      "RecordExceptions": true,
      "ExcludeHealthChecks": true,
      "OtlpEnabled": true,
      "DefaultSamplingRatio": 1.0
    },
    "Metrics": {
      "Enabled": true,
      "Prometheus": {
        "Enabled": true,
        "Path": "/metrics",
        "Port": 9464
      }
    },
    "Logs": {
      "Enabled": true,
      "ConsoleEnabled": true,
      "Logstash": {
        "Enabled": true,
        "Endpoint": ""
      },
      "DataStream": {
        "Dataset": "findair",
        "Namespace": "development"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EcsHttp": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "Gateway": {
    "ShutdownTimeoutSeconds": 30,
    "RuleRefreshIntervalSeconds": 60,
    "RuleRefreshJitterSeconds": 5,
    "MaxPhotoAgeDays": 30
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "InputQueue": "gateway.input.q",
    "OutputQueue": "int.algo.tb_publisher",
    "OutputQueueHeaders": {
      "x-dead-letter-exchange": "",
      "x-dead-letter-routing-key": "int.algo.tb_publisher.dlq"
    },
    "DeadLetterQueue": "gateway.dlq.q",
    "RetryExchange": "pipeline.retry.x",
    "RetryExchangeType": "headers",
    "RetryRoutingKey": "gateway.retry",
    "PrefetchCount": 2,
    "ConsumerConcurrency": 4,
    "PublisherChannelPoolSize": 8,
    "OutputPublishConcurrency": 8,
    "MaxRetryAttempts": 3,
    "RetryQueues": [
      {
        "RetryCount": 1,
        "Queue": "gateway.retry.1.q",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "retry-count": 1
        }
      },
      {
        "RetryCount": 2,
        "Queue": "gateway.retry.2.q",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "retry-count": 2
        }
      },
      {
        "RetryCount": 3,
        "Queue": "gateway.retry.3.q",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "retry-count": 3
        }
      }
    ],
    "ReconnectDelaySeconds": 5
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "Index": "rules",
    "TimeoutSeconds": 30
  }
}
