{
  "Observability": {
    "Enabled": true,
    "ServiceNamespace": "findair",
    "DeploymentEnvironment": "development",
    "Traces": {
      "Enabled": true,
      "RecordExceptions": true,
      "ExcludeHealthChecks": true,
      "OtlpEnabled": true,
      "DefaultSamplingRatio": 1.0
    },
    "Metrics": {
      "Enabled": true,
      "Prometheus": {
        "Enabled": true,
        "Path": "/metrics",
        "Port": 8080
      }
    },
    "Logs": {
      "Enabled": true,
      "ConsoleEnabled": true,
      "Logstash": {
        "Enabled": true,
        "Endpoint": ""
      },
      "DataStream": {
        "Dataset": "findair",
        "Namespace": "development"
      }
    }
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "Index": "rules",
    "Username": "",
    "Password": "",
    "TimeoutSeconds": 30,
    "DefaultSearchSize": 100,
    "MaxSearchSize": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EcsHttp": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning"
      }
    }
  },
  "AutoRun": {
    "Enabled": false,
    "MaxSelectedOverlays": 100000,
    "MaxScannedRecords": 1000000,
    "MaxCandidates": 200000,
    "PayloadBudgetBytes": 536870912,
    "ReadyLifetimeMinutes": 30,
    "SummaryLifetimeMinutes": 60,
    "MaxRetainedJobs": 100,
    "PublishTimeoutSeconds": 30,
    "PublisherConcurrency": 4,
    "Publication": { "BatchSize": 10, "DelayMs": 1000 },
    "Provider": {
      "BaseUrl": "",
      "TableEntitiesPath": "/ErisImages/v2.0/ErisImages/Images/TableEntities",
      "TimeoutSeconds": 30,
      "Headers": {}
    }
  },
  "AllowedHosts": "*"
}
