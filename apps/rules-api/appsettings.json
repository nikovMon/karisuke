{
  "Observability": {
    "Enabled": true,
    "ServiceNamespace": "findair",
    "DeploymentEnvironment": "development",
    "Traces": {
      "Enabled": true,
      "RecordExceptions": true,
      "ExcludeHealthChecks": true,
      "OtlpEnabled": true,
      "DefaultSamplingRatio": 1.0
    },
    "Metrics": {
      "Enabled": true,
      "Prometheus": {
        "Enabled": true,
        "Path": "/metrics",
        "Port": 8080
      }
    },
    "Logs": {
      "Enabled": true,
      "ConsoleEnabled": true,
      "Logstash": {
        "Enabled": true,
        "Endpoint": ""
      },
      "DataStream": {
        "Dataset": "findair",
        "Namespace": "development"
      }
    }
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "Index": "rules",
    "Username": "",
    "Password": "",
    "TimeoutSeconds": 30,
    "DefaultSearchSize": 100,
    "MaxSearchSize": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EcsHttp": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning"
      }
    }
  },
  "AutoRun": {
    "Enabled": false,
    "MaxSelectedOverlays": 100000,
    "MaxScannedRecords": 1000000,
    "MaxCandidates": 200000,
    "PayloadBudgetBytes": 536870912,
    "Memory": { "LimitBytes": 0, "MaxUsagePercent": 80, "MinimumFreeBytes": 268435456 },
    "Ui": { "MapUrl": "" },
    "ReadyLifetimeMinutes": 30,
    "SummaryLifetimeMinutes": 60,
    "MaxRetainedJobs": 100,
    "PublishTimeoutSeconds": 30,
    "PublisherConcurrency": 4,
    "Publication": { "BatchSize": 10, "DelayMs": 1000 },
    "Provider": {
      "BaseUrl": "",
      "TableEntitiesPath": "/ErisImages/v2.0/ErisImages/Images/TableEntities",
      "To": 1000,
      "TimeoutSeconds": 30,
      "RequestDelayMs": 1000,
      "MaxRetries": 2,
      "RetryDelayMs": 2000,
      "MaxResponseBytes": 67108864,
      "Headers": {},
      "RequestFields": { "SensorType": "sensorType.keyword" },
      "SensorTypeMappings": {
        "VIS": "VIS",
        "PAN": "PAN",
        "PAN_Sharpen_RGB": "PAN_Sharpen_RGB",
        "PAN_MSI": "PAN_MSI",
        "EO": "EO",
        "IR": "IR",
        "CIR": "CIR",
        "NIR": "NIR",
        "MWIR": "MWIR",
        "SAR": "SAR",
        "SWIR": "SWIR"
      }
    }
  },
  "AllowedHosts": "*"
}
