{
  "Observability": {
    "Enabled": true,
    "Otlp": {
      "Enabled": true
    },
    "Traces": {
      "Enabled": true,
      "RecordExceptions": true,
      "ExcludeHealthChecks": true,
      "DefaultSamplingRatio": 0.10
    },
    "Metrics": {
      "Enabled": true
    },
    "Logs": {
      "Enabled": true,
      "OtlpEnabled": true,
      "ConsoleEnabled": false,
      "IncludeFormattedMessage": true,
      "IncludeScopes": true,
      "ParseStateValues": true
    }
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "Index": "rules",
    "Username": "",
    "Password": "",
    "TimeoutSeconds": 30
  },
  "Rules": {
    "IndexName": "rules",
    "DefaultSearchSize": 100,
    "MaxSearchSize": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
