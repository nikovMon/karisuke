{
  "Observability": {
    "Enabled": true,
    "ServiceNamespace": "imaging-pipeline",
    "DeploymentEnvironment": "development",
    "Traces": {
      "Enabled": true,
      "RecordExceptions": true,
      "ExcludeHealthChecks": true,
      "OtlpEnabled": true,
      "DefaultSamplingRatio": 1.0
    },
    "Metrics": {
      "Enabled": true,
      "Prometheus": {
        "Enabled": true,
        "Path": "/metrics",
        "Port": 9464
      }
    },
    "Logs": {
      "Enabled": true,
      "ConsoleEnabled": false,
      "Logstash": {
        "Enabled": true,
        "Endpoint": ""
      },
      "DataStream": {
        "Dataset": "findair",
        "Namespace": "development"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "admin",
    "Password": "admin",
    "VirtualHost": "/",
    "InputQueue": "int.algo.tb_publisher",
    "OutputQueue": "int.algo.tb_publisher.tiling_config",
    "DeadLetterQueue": "int.algo.tb_publisher.dlq",
    "RetryExchange": "int.algo.tb_publisher.retry.x",
    "RetryExchangeType": "headers",
    "RetryRoutingKey": "int.algo.tb_publisher.retry",
    "MaxRetryAttempts": 3,
    "RetryQueues": [
      {
        "RetryCount": 1,
        "Queue": "int.algo.tb_publisher.retry.1",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "retry-count": 1
        }
      },
      {
        "RetryCount": 2,
        "Queue": "int.algo.tb_publisher.retry.2",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "retry-count": 2
        }
      },
      {
        "RetryCount": 3,
        "Queue": "int.algo.tb_publisher.retry.3",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "retry-count": 3
        }
      }
    ],
    "PrefetchCount": 4,
    "ConsumerConcurrency": 4,
    "PublisherChannelPoolSize": 4,
    "OutputPublishConcurrency": 4,
    "ReconnectDelaySeconds": 5
  },
  "ProjectionMapper": {
    "Host": "http://projection-mapper:8080",
    "Endpoints": {
      "G2IMultiPoints": "/flare/g2i-by-id",
      "I2GById": "/flare/i2g-by-id",
      "I2GByRegistration": "/flare/i2g-by-registration"
    },
    "SendingSystem": "flare",
    "UseCache": false,
    "TimeoutSeconds": 10
  }
}
