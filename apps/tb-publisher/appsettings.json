{
  "Observability": {
    "Enabled": true,
    "Otlp": {
      "Enabled": true
    },
    "Traces": {
      "Enabled": true,
      "RecordExceptions": true,
      "ExcludeHealthChecks": true,
      "DefaultSamplingRatio": 0.10
    },
    "Metrics": {
      "Enabled": true
    },
    "Logs": {
      "Enabled": true,
      "OtlpEnabled": true,
      "ConsoleEnabled": true,
      "IncludeFormattedMessage": true,
      "IncludeScopes": true,
      "ParseStateValues": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "admin",
    "Password": "admin",
    "VirtualHost": "/",
    "InputQueue": "int.algo.tb_publisher",
    "OutputQueue": "int.algo.tb_publisher.tiling_config",
    "DeadLetterQueue": "int.algo.tb_publisher.dlq",
    "InputExchange": "pipeline.x",
    "InputExchangeType": "fanout",
    "InputRoutingKey": "tb-publisher.output",
    "OutputExchange": "",
    "DeadLetterExchange": "",
    "RetryExchange": "int.algo.tb_publisher.retry.x",
    "RetryExchangeType": "headers",
    "RetryRoutingKey": "int.algo.tb_publisher.retry",
    "RetryDelayMilliseconds": 10000,
    "MaxRetryAttempts": 3,
    "RetryCountHeader": "x-retry-count",
    "RetryQueues": [
      {
        "RetryCount": 1,
        "Queue": "int.algo.tb_publisher.retry.1",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "x-retry-count": 1
        }
      },
      {
        "RetryCount": 2,
        "Queue": "int.algo.tb_publisher.retry.2",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "x-retry-count": 2
        }
      },
      {
        "RetryCount": 3,
        "Queue": "int.algo.tb_publisher.retry.3",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "x-retry-count": 3
        }
      }
    ],
    "PrefetchCount": 4,
    "ConsumerConcurrency": 4,
    "PublisherChannelPoolSize": 4,
    "OutputPublishConcurrency": 4,
    "ReconnectDelaySeconds": 5
  },
  "ProjectionMapper": {
    "Host": "http://projection-mapper:8080",
    "Endpoints": {
      "G2IMultiPoints": "/flare/g2i-by-id"
    },
    "SendingSystem": "flare",
    "UseCache": false,
    "TimeoutSeconds": 10
  }
}
