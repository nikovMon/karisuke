{
  "Observability": {
    "Enabled": true,
    "ServiceNamespace": "imaging-pipeline",
    "DeploymentEnvironment": "integration",
    "Traces": {
      "Enabled": true,
      "OtlpEnabled": false,
      "ExcludeHealthChecks": true
    },
    "Metrics": {
      "Enabled": true,
      "Prometheus": {
        "Enabled": true,
        "Path": "/metrics",
        "Port": 9464
      }
    },
    "Logs": {
      "Enabled": true,
      "ConsoleEnabled": true,
      "Logstash": {
        "Enabled": false
      },
      "DataStream": {
        "Dataset": "unified-gateway",
        "Namespace": "integration"
      }
    }
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "Username": "",
    "Password": "",
    "TimeoutSeconds": 30
  },
  "RuleRefresh": {
    "IntervalSeconds": 60,
    "JitterSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "InputQueue": "unified-gateway.input.q",
    "DeadLetterQueue": "unified-gateway.dlq.q",
    "RetryExchange": "pipeline.retry.x",
    "RetryExchangeType": "headers",
    "RetryRoutingKey": "unified-gateway.retry",
    "PrefetchCount": 2,
    "ConsumerConcurrency": 4,
    "PublisherChannelPoolSize": 8,
    "MaxRetryAttempts": 3,
    "RetryQueues": [
      {
        "RetryCount": 1,
        "Queue": "unified-gateway.retry.1.q",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "retry-count": 1
        }
      },
      {
        "RetryCount": 2,
        "Queue": "unified-gateway.retry.2.q",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "retry-count": 2
        }
      },
      {
        "RetryCount": 3,
        "Queue": "unified-gateway.retry.3.q",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "retry-count": 3
        }
      }
    ],
    "ReconnectDelaySeconds": 5
  }
}
