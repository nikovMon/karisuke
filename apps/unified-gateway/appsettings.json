{
  "Observability": {
    "Enabled": true,
    "ServiceNamespace": "imaging-pipeline",
    "DeploymentEnvironment": "integration",
    "Traces": {
      "Enabled": true,
      "OtlpEnabled": false,
      "ExcludeHealthChecks": true
    },
    "Metrics": {
      "Enabled": true,
      "Prometheus": {
        "Enabled": true,
        "Path": "/metrics",
        "Port": 9464
      }
    },
    "Logs": {
      "Enabled": true,
      "ConsoleEnabled": true,
      "Logstash": { "Enabled": false },
      "DataStream": { "Dataset": "unified-gateway", "Namespace": "integration" }
    }
  },
  "PipelineCatalog": {
    "RabbitMqConnections": {
      "asd-output": {
        "Hostname": "localhost",
        "Port": 5673,
        "Username": "guest",
        "Password": "guest",
        "VirtualHost": "/"
      }
    },
    "Pipelines": [
      {
        "PipelineId": "asd",
        "Enabled": true,
        "ContractId": "asd",
        "RulesIndex": "asd-integ-pipeline-index",
        "ExtraData": {},
        "Transport": {
          "Kind": "rabbitmq",
          "RabbitMq": {
            "ConnectionRef": "asd-output",
            "Output": {
              "QueueName": "int.algo.tb_publisher",
              "Arguments": {
                "x-dead-letter-exchange": "",
                "x-dead-letter-routing-key": "int.algo.tb_publisher.dlq"
              },
              "ExchangeSettings": {
                "ShouldBindToExchange": false,
                "ExchangeName": "",
                "ExchangeType": "direct",
                "RoutingKey": "",
                "Arguments": {},
                "BindingArguments": {}
              }
            }
          }
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
