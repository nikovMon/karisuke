{
  "Observability": {
    "Enabled": true,
    "ServiceNamespace": "imaging-pipeline",
    "DeploymentEnvironment": "integration",
    "Traces": {
      "Enabled": true,
      "OtlpEnabled": false,
      "ExcludeHealthChecks": true
    },
    "Metrics": {
      "Enabled": true,
      "Prometheus": {
        "Enabled": true,
        "Path": "/metrics",
        "Port": 9464
      }
    },
    "Logs": {
      "Enabled": true,
      "ConsoleEnabled": true,
      "Logstash": {
        "Enabled": false
      },
      "DataStream": {
        "Dataset": "unified-gateway",
        "Namespace": "integration"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
