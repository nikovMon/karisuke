{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "admin",
    "Password": "admin",
    "InputQueue": "int.algo.tile_builder.output",
    "OutputQueue": "int.algo.embedder.input",
    "DeadLetterQueue": "int.algo.tile_builder.dlq",
    "PrefetchCount": 1,
    "RetryDelayMilliseconds": 10000,
    "MaxRetryAttempts": 3,
    "RetryCountHeader": "x-retry-count",
    "RetryQueues": [
      {
        "RetryCount": 1,
        "Queue": "int.algo.tile_builder.retry.1.q",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "x-retry-count": 1
        }
      },
      {
        "RetryCount": 2,
        "Queue": "int.algo.tile_builder.retry.2.q",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "x-retry-count": 2
        }
      },
      {
        "RetryCount": 3,
        "Queue": "int.algo.tile_builder.retry.3.q",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "x-retry-count": 3
        }
      }
    ]
  },
  "ProjectionMapper": {
    "Host": "http://projection-mapper",
    "SendingSystem": "tb-consumer",
    "TimeoutSeconds": 10,
    "Endpoints": {
      "g2i-multipoints": "/api/v1/projection/g2i-multipoints",
      "i2gById": "/v3/projectionmapper/i2g-by-id"
    }
  }
}