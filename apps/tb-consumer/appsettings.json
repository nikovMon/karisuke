{
  "Observability": {
    "Enabled": true,
    "ServiceNamespace": "findair",
    "DeploymentEnvironment": "development",
    "Traces": {
      "Enabled": true,
      "RecordExceptions": true,
      "ExcludeHealthChecks": true,
      "OtlpEnabled": true,
      "DefaultSamplingRatio": 1.0
    },
    "Metrics": {
      "Enabled": true,
      "Prometheus": {
        "Enabled": true,
        "Path": "/metrics",
        "Port": 9464
      }
    },
    "Logs": {
      "Enabled": true,
      "ConsoleEnabled": true,
      "Logstash": {
        "Enabled": true,
        "Endpoint": ""
      },
      "DataStream": {
        "Dataset": "findair",
        "Namespace": "development"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EcsHttp": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "admin",
    "Password": "admin",
    "VirtualHost": "/",
    "InputQueue": "int.algo.tile_builder.output",
    "OutputQueue": "int.algo.embedder.input",
    "DeadLetterQueue": "int.algo.tile_builder.dlq",
    "RetryExchange": "tb-consumer.retry.x",
    "RetryExchangeType": "headers",
    "RetryRoutingKey": "tb-consumer.retry",
    "PrefetchCount": 1,
    "MaxRetryAttempts": 3,
    "ForwardedInputStage": "TileBuilder",
    "RetryQueues": [
      {
        "RetryCount": 1,
        "Queue": "tb-consumer.retry.1.q",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "retry-count": 1
        }
      },
      {
        "RetryCount": 2,
        "Queue": "tb-consumer.retry.2.q",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "retry-count": 2
        }
      },
      {
        "RetryCount": 3,
        "Queue": "tb-consumer.retry.3.q",
        "DelayMilliseconds": 10000,
        "BindingArguments": {
          "retry-count": 3
        }
      }
    ],
    "ConsumerConcurrency": 1,
    "PublisherChannelPoolSize": 4,
    "OutputPublishConcurrency": 4,
    "ReconnectDelaySeconds": 5
  },
  "ProjectionMapper": {
    "Host": "http://projection-mapper",
    "SendingSystem": "tb-consumer",
    "TimeoutSeconds": 10,
    "Endpoints": {
      "G2IMultiPoints": "/api/v1/projection/g2i-multipoints",
      "I2GById": "/v3/projectionmapper/i2g-by-id",
      "I2GByRegistration": "/v3/projectionmapper/i2g-by-registration"
    }
  }
}
